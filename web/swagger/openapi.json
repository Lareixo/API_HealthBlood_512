    "/addMedida": {
      "post": {
        "tags": ["Medidas"],
        "summary": "Crear una medida",
        "description": "Acepta JSON o formulario. `idUsuario` y `glucosa` son obligatorios. Si no se envia `fechaHora`, se usa la fecha y hora actual. Formatos de fecha aceptados: `2026-11-09 20:00:00`, `2026-11-09T20:00:00`, `2026-11-09 20:00`.",
        "operationId": "addMedida",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MedidaInput" },
              "example": {
                "idUsuario": 1,
                "glucosa": 123,
                "fechaHora": "2026-11-09 20:00:00",
                "contexto": "Prueba Swagger",
                "notas": "Medida creada desde el tester"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/MedidaInput" },
              "example": {
                "idUsuario": 1,
                "glucosa": 123,
                "fechaHora": "2026-11-09 20:00:00",
                "contexto": "Prueba Swagger",
                "notas": "Medida creada desde el tester"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Medida creada.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Medida" },
                "example": {
                  "idMedida": 50,
                  "idUsuario": 1,
                  "glucosa": 123,
                  "fechaHora": "2026-11-09 20:00:00",
                  "contexto": "Prueba Swagger",
                  "notas": "Medida creada desde el tester"
                }
              }
            }
          },
          "400": {
            "description": "Datos invalidos, usuario inexistente o fecha incorrecta.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Error al guardar.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Medidas"],
        "summary": "Crear una medida desde el navegador (query)",
        "operationId": "addMedidaDesdeNavegador",
        "parameters": [
          {
            "name": "idUsuario",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 },
            "example": 1
          },
          {
            "name": "glucosa",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 },
            "example": 123
          },
          {
            "name": "fechaHora",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "example": "2026-11-09 20:00:00"
          },
          {
            "name": "contexto",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "maxLength": 40 },
            "example": "Ayuno"
          },
          {
            "name": "notas",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "maxLength": 100 },
            "example": "Medida desde el navegador"
          }
        ],
        "responses": {
          "201": {
            "description": "Medida creada.",
            "content": {
              "application/json": {
