  "components": {
    "schemas": {
      "SaludoResponse": {
        "type": "object",
        "properties": {
          "response": { "type": "string" }
        }
      },
      "EstadoResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "database": { "type": "string", "example": "ok" },
          "usuarios": { "type": "integer", "example": 17 }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "idUsuario": { "type": "integer", "example": 1 },
          "nombre": { "type": "string", "maxLength": 40, "example": "Sebastian" },
          "primerApellido": { "type": "string", "maxLength": 40, "example": "G" },
          "segundoApellido": { "type": "string", "maxLength": 40, "nullable": true, "example": "R" },
          "email": { "type": "string", "maxLength": 50, "example": "sebastian@gmail.com" }
        },
        "required": ["idUsuario", "nombre", "primerApellido", "email"]
      },
      "UsuarioInput": {
        "type": "object",
        "required": ["nombre", "primerApellido", "email"],
        "properties": {
          "nombre": { "type": "string", "maxLength": 40, "description": "Nombre del usuario.", "example": "Bruno" },
          "primerApellido": { "type": "string", "maxLength": 40, "description": "Primer apellido.", "example": "Prueba" },
          "segundoApellido": { "type": "string", "maxLength": 40, "description": "Segundo apellido (opcional).", "example": "CRUD" },
          "email": { "type": "string", "maxLength": 50, "description": "Correo electronico.", "example": "bruno.crud@gluapi.com" }
        }
      },
      "UsuarioUpdateResponse": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "example": "Usuario actualizado" },
          "usuario": { "$ref": "#/components/schemas/Usuario" }
        }
      },
      "UsuarioDeleteResponse": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "example": "Usuario eliminado" },
          "idUsuario": { "type": "integer", "example": 18 },
          "medidasEliminadas": { "type": "integer", "example": 0 }
        }
      },
      "Medida": {
        "type": "object",
        "properties": {
          "idMedida": { "type": "integer", "example": 1 },
          "idUsuario": { "type": "integer", "example": 1 },
          "glucosa": { "type": "integer", "example": 110 },
          "fechaHora": { "type": "string", "example": "2026-11-01 08:00:00" },
          "contexto": { "type": "string", "maxLength": 40, "nullable": true, "example": "Ayuno" },
          "notas": { "type": "string", "maxLength": 100, "nullable": true, "example": "Medicion de la manana" }
        },
        "required": ["idMedida", "idUsuario", "glucosa"]
      },
      "MedidaInput": {
        "type": "object",
        "required": ["idUsuario", "glucosa"],
        "properties": {
          "idUsuario": { "type": "integer", "minimum": 1, "description": "Usuario dueno de la medida (debe existir).", "example": 1 },
          "glucosa": { "type": "integer", "minimum": 1, "description": "Valor de glucosa.", "example": 123 },
          "fechaHora": { "type": "string", "description": "Fecha y hora. Si se omite se usa la actual.", "example": "2026-11-09 20:00:00" },
          "contexto": { "type": "string", "maxLength": 40, "description": "Contexto de la medicion.", "example": "Ayuno" },
          "notas": { "type": "string", "maxLength": 100, "description": "Notas libres.", "example": "Medida desde Swagger" }
        }
      },
      "MedidaUpdateResponse": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "example": "Medida actualizada" },
          "medida": { "$ref": "#/components/schemas/Medida" }
        }
      },
      "MedidaDeleteResponse": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "example": "Medida eliminada" },
          "idMedida": { "type": "integer", "example": 50 }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "result": { "type": "string", "example": "Usuario no encontrado" }
        }
      }
    }
  }
