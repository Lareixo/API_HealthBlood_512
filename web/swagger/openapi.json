{
  "openapi": "3.0.3",
  "info": {
    "title": "API HealthBlood 512 (Gluapi)",
    "version": "2.0.0",
    "description": "API REST para gestionar usuarios y medidas de glucosa. Incluye el CRUD completo (crear, leer, actualizar y eliminar) y endpoints de sistema.\n\n**Como probar:** abre cualquier endpoint, pulsa **Try it out**, completa los parametros y pulsa **Execute**. Las peticiones se envian a la misma URL donde esta publicado este tester (local o Render).\n\n> Las rutas de esta documentacion son las rutas cortas (`/getAllUsuarios`, `/addUsuario`, ...). El filtro de la API las redirige automaticamente a `/api/glucosa/...`."
  },
  "servers": [
    {
      "url": "/API_HealthBlood_512",
      "description": "Mismo servidor donde esta publicado este Swagger (local o Render)"
    }
  ],
  "tags": [
    {
      "name": "Sistema",
      "description": "Endpoints basicos para comprobar que la API y la base de datos responden."
    },
    {
      "name": "Usuarios",
      "description": "CRUD completo de usuarios."
    },
    {
      "name": "Medidas",
      "description": "CRUD completo de medidas de glucosa."
    }
  ],
  "paths": {
    "/saludar": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Saludo de prueba",
        "description": "Devuelve un mensaje fijo para comprobar que la API responde.",
        "operationId": "saludar",
        "responses": {
          "200": {
            "description": "La API responde correctamente.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SaludoResponse" },
                "example": { "response": "Hola desde Java" }
              }
            }
          }
        }
      }
    },
    "/estado": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Estado de la API y la base de datos",
        "description": "Comprueba la conexion con la base de datos y devuelve el total de usuarios.",
        "operationId": "estado",
        "responses": {
          "200": {
            "description": "API y base de datos funcionando.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EstadoResponse" },
                "example": { "status": "ok", "database": "ok", "usuarios": 17 }
              }
            }
          },
          "503": {
            "description": "La API no pudo conectar con la base de datos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EstadoResponse" },
                "example": { "status": "error", "database": "error" }
              }
            }
          }
        }
      }
    },
    "/saludarPersonalizado": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Saludo personalizado",
        "operationId": "saludarPersonalizado",
        "parameters": [
          {
            "name": "nombre",
            "in": "query",
            "required": false,
            "description": "Nombre que aparece en el saludo.",
            "schema": { "type": "string" },
            "example": "Sebastian"
          }
        ],
        "responses": {
          "200": {
            "description": "Saludo generado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SaludoResponse" },
                "example": { "response": "Hola Sebastian desde Java" }
              }
            }
          }
        }
      }
    },
    "/Numero": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Calcular el cuadrado de un numero",
        "operationId": "numero",
        "parameters": [
          {
            "name": "numero",
            "in": "query",
            "required": true,
            "description": "Numero entero que se quiere elevar al cuadrado.",
            "schema": { "type": "integer" },
            "example": 7
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado del calculo.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SaludoResponse" },
                "example": { "response": "El cuadrado del numero 7 es: 49" }
              }
            }
          }
        }
      }
    },
    "/getAllUsuarios": {
      "get": {
        "tags": ["Usuarios"],
        "summary": "Listar todos los usuarios",
        "operationId": "getAllUsuarios",
        "responses": {
          "200": {
            "description": "Lista de usuarios.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Usuario" }
                },
                "example": [
                  {
                    "idUsuario": 1,
                    "nombre": "Sebastian",
                    "primerApellido": "G",
                    "segundoApellido": "R",
                    "email": "sebastian@gmail.com"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Error al consultar la base de datos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "result": "Error al obtener los usuarios" }
              }
            }
          }
        }
      }
    },
    "/getUsuarioById": {
      "get": {
        "tags": ["Usuarios"],
        "summary": "Obtener un usuario por id (query)",
        "operationId": "getUsuarioById",
        "parameters": [
          {
            "name": "idUsuario",
            "in": "query",
            "required": true,
            "description": "Id del usuario.",
            "schema": { "type": "integer", "minimum": 1 },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Usuario" }
              }
            }
          },
          "400": {
            "description": "Falta el id o no es valido.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "result": "Usuario no encontrado" }
              }
            }
          },
          "500": {
            "description": "Error interno.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/getUsuarioById/{idUsuario}": {
      "get": {
        "tags": ["Usuarios"],
        "summary": "Obtener un usuario por id (ruta)",
        "operationId": "getUsuarioByIdPorRuta",
        "parameters": [
          {
            "name": "idUsuario",
            "in": "path",
            "required": true,
            "description": "Id del usuario.",
            "schema": { "type": "integer", "minimum": 1 },
