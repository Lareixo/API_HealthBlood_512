          },
          "404": {
            "description": "Usuario no encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/addUsuario": {
      "post": {
        "tags": ["Usuarios"],
        "summary": "Crear un usuario",
        "description": "Acepta el usuario como JSON o como formulario. Nombre, primer apellido y email son obligatorios. Devuelve 201 con el usuario creado y su id.",
        "operationId": "addUsuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UsuarioInput" },
              "example": {
                "nombre": "Bruno",
                "primerApellido": "Prueba",
                "segundoApellido": "CRUD",
                "email": "bruno.crud@gluapi.com"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/UsuarioInput" },
              "example": {
                "nombre": "Bruno",
                "primerApellido": "Prueba",
                "segundoApellido": "CRUD",
                "email": "bruno.crud@gluapi.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Usuario" },
                "example": {
                  "idUsuario": 18,
                  "nombre": "Bruno",
                  "primerApellido": "Prueba",
                  "segundoApellido": "CRUD",
                  "email": "bruno.crud@gluapi.com"
                }
              }
            }
          },
          "400": {
            "description": "Datos invalidos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "result": "Los campos nombre, primerApellido y email son obligatorios" }
              }
            }
          },
          "500": {
            "description": "Error al guardar.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      },
      "get": {
        "tags": ["Usuarios"],
        "summary": "Crear un usuario desde el navegador (query)",
        "description": "Variante GET del alta de usuario, pensada para probar desde la barra del navegador.",
        "operationId": "addUsuarioDesdeNavegador",
        "parameters": [
          {
            "name": "nombre",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "maxLength": 40 },
            "example": "Bruno"
          },
          {
            "name": "primerApellido",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "maxLength": 40 },
            "example": "Prueba"
          },
          {
            "name": "segundoApellido",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "maxLength": 40 },
            "example": "CRUD"
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "maxLength": 50 },
            "example": "bruno.crud@gluapi.com"
          }
        ],
        "responses": {
          "201": {
            "description": "Usuario creado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Usuario" }
              }
            }
          },
          "400": {
            "description": "Datos invalidos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/updateUsuario/{idUsuario}": {
      "put": {
        "tags": ["Usuarios"],
        "summary": "Actualizar un usuario por id (ruta)",
        "description": "Envia el JSON completo con los datos del usuario. El id de la ruta manda sobre el del body.",
        "operationId": "updateUsuario",
        "parameters": [
          {
            "name": "idUsuario",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 },
            "example": 18
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UsuarioInput" },
              "example": {
                "nombre": "Bruno",
                "primerApellido": "Actualizado",
                "segundoApellido": "CRUD",
                "email": "bruno.crud@gluapi.com"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsuarioUpdateResponse" }
              }
            }
          },
          "400": {
            "description": "Datos invalidos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Error al actualizar.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/updateUsuario": {
      "put": {
        "tags": ["Usuarios"],
        "summary": "Actualizar un usuario por id (query)",
        "operationId": "updateUsuarioPorQuery",
        "parameters": [
          {
            "name": "idUsuario",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 },
            "example": 18
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UsuarioInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario actualizado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsuarioUpdateResponse" }
              }
            }
          },
          "400": {
            "description": "Id o datos invalidos.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/deleteUsuario/{idUsuario}": {
      "delete": {
        "tags": ["Usuarios"],
        "summary": "Eliminar un usuario por id (ruta)",
        "description": "Si el usuario tiene medidas, la API responde 409. Usa `cascade=true` para borrar tambien todas sus medidas.",
        "operationId": "deleteUsuario",
        "parameters": [
          {
            "name": "idUsuario",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 },
            "example": 18
          },
          {
            "name": "cascade",
            "in": "query",
            "required": false,
            "description": "true = elimina tambien las medidas del usuario.",
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario eliminado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsuarioDeleteResponse" },
                "example": { "result": "Usuario eliminado", "idUsuario": 18, "medidasEliminadas": 0 }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "El usuario tiene medidas y no se envio cascade=true.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" },
                "example": { "result": "El usuario tiene 3 medida(s) registrada(s). Use ?cascade=true para eliminarlas junto con el usuario" }
              }
            }
          },
          "500": {
            "description": "Error al eliminar.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/deleteUsuario": {
      "delete": {
        "tags": ["Usuarios"],
        "summary": "Eliminar un usuario por id (query)",
        "operationId": "deleteUsuarioPorQuery",
        "parameters": [
          {
            "name": "idUsuario",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "minimum": 1 },
            "example": 18
          },
          {
            "name": "cascade",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario eliminado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsuarioDeleteResponse" }
              }
            }
          },
          "400": {
            "description": "Id invalido.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "404": {
            "description": "Usuario no encontrado.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "409": {
            "description": "El usuario tiene medidas y no se envio cascade=true.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
